# Local Docker Compose defaults. Copy to .env to customize.
DB_NAME=procurehub
DB_USER=postgres
DB_PASSWORD=procurehub_local
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=4000
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:5173
CACHE_TTL_SECONDS=60
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_SECONDS=60
JWT_SECRET=local-dev-access-secret-change-before-deploy-01
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-before-deploy-02
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
ORDER_RESERVATION_TTL_HOURS=24
REFRESH_COOKIE_NAME=procurehub_refresh
LOG_LEVEL=info

# For production, use docker-compose.prod.yml and set strong unique JWT secrets,
# a strong database password, an HTTPS CORS_ORIGIN, and the public frontend API URL.
