PORT=4000
NODE_ENV=development
# These database defaults and example secrets are for local development only.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=procurehub
DB_USER=postgres
DB_PASSWORD=postgres
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_SECONDS=60
JWT_SECRET=change_this_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
ORDER_RESERVATION_TTL_HOURS=24
REFRESH_COOKIE_NAME=procurehub_refresh
CORS_ORIGIN=http://localhost:5173
# In production, set DB_* and distinct random JWT secrets (at least 32 characters),
# and configure comma-separated HTTPS frontend origins. Never commit production secrets.
LOG_LEVEL=info
